    "intro": "",
    "sections": [
      {
        "num": "0.1",
        "title": "What This Subject Covers",
        "intro": "",
        "subs": [
          {
            "title": "0.1.1 The one-line idea",
            "body": "A verified problem still needs a well-designed answer. This subject teaches a human-centered way to go from problem to prototype to pilot without wasting months on features nobody needs."
          },
          {
            "title": "0.1.2 What you will be able to do",
            "body": "- Build user personas and journey maps from real interviews\n- Reframe a problem into clear design questions\n- Generate, compare and prioritise solution ideas\n- Wireframe and prototype quickly\n- Define and ship a minimum viable product\n- Test with users and run a pilot with a real customer\n- Pitch the result to judges, sponsors and customers"
          }
        ]
