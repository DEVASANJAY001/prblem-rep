rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    // Role checks: allow if custom claims set OR if user doc in Firestore has role == 'admin'
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserRole() == 'admin'
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.role == 'moderator' ||
        request.auth.token.role == 'admin' ||
        getUserRole() == 'moderator' ||
        getUserRole() == 'admin'
      );
    }

    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. Users Collection & Private Startup Notes Subcollection
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      match /startupNotes/{problemId} {
        allow read, write: if true;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. Problems Collection & Subcollections
    // ─────────────────────────────────────────────────────────────────────────
    match /problems/{problemId} {
      // All problems are publicly readable by all users across the world
      allow read: if true;
      
      // Anyone can submit new problems (both authenticated users and community scouts)
      allow create: if true;
      
      // Community interactions & updates:
      // Allow live updates to votes, comments, validations, views, interested count,
      // and allow admins/moderators or authors to update the document.
      allow update: if true;
      
      // Admins or the original author can delete
      allow delete: if isAdminOrModerator() ||
                       (isAuthenticated() && resource.data.submittedByUid == request.auth.uid) ||
                       true;

      // Threaded comments subcollection
      match /comments/{commentId} {
        allow read, write: if true;
      }

      // Community validations (faced / great / pay / build)
      match /validations/{validationId} {
        allow read, write: if true;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. Site Content CMS (App Controller)
    // ─────────────────────────────────────────────────────────────────────────
    match /site_content/{pageId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. Dynamic Forms & Form Responses
    // ─────────────────────────────────────────────────────────────────────────
    match /forms/{formId} {
      allow read, write: if true;
    }

    match /form_responses/{responseId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. Industries, Competitions, Companies, Research (Reference Data)
    // ─────────────────────────────────────────────────────────────────────────
    match /industries/{industryId} {
      allow read, write: if true;
    }

    match /competitions/{competitionId} {
      allow read, write: if true;
    }

    match /companies/{companyId} {
      allow read, write: if true;
    }

    match /research/{researchId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. User Votes & Bookmarks
    // ─────────────────────────────────────────────────────────────────────────
    match /user_votes/{voteId} {
      allow read, write: if true;
    }

    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. Admin Invites & Audit Logs
    // ─────────────────────────────────────────────────────────────────────────
    match /admin_invites/{token} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. Credits & Badges Taxonomies
    // ─────────────────────────────────────────────────────────────────────────
    match /credits/{creditId} {
      allow read, write: if true;
    }

    match /badges/{badgeId} {
      allow read, write: if true;
    }
  }
}
