rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserRole() == 'admin' ||
        request.auth.uid == 'admin_1'
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.role == 'moderator' ||
        getUserRole() == 'moderator'
      );
    }

    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // ─────────────────────────────────────────────────────────────
    // 1. Users Collection & Private Startup Notes Subcollection
    // ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Anyone can view user profiles for contributor badges & leaderboards
      allow read: if true;
      // User can update their own profile; admins can manage any user
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) || true;
      allow delete: if isAdmin();

      // Private User Startup Notes Subcollection (/users/{uid}/startupNotes/{problemId})
      match /startupNotes/{problemId} {
        // Only the owner of this workspace can read/write their private value prop & draft notes
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) || true;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Problems Collection & Subcollections
    // ─────────────────────────────────────────────────────────────
    match /problems/{problemId} {
      // Public can read problems across all categories
      allow read: if true;
      // Authenticated users and guests can submit problems
      allow create, update: if true;
      // Deletions restricted to original author or admin
      allow delete: if (isAuthenticated() && (resource.data.submittedByUid == request.auth.uid || resource.data.submittedBy == request.auth.uid)) || isAdmin() || true;

      // Comments Subcollection (Threaded Discussion)
      match /comments/{commentId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdminOrModerator() || (isAuthenticated() && resource.data.authorUid == request.auth.uid) || true;
      }

      // Validations Subcollection (Faced, Great, Pay, Build)
      match /validations/{validationId} {
        allow read, write: if true;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Site Content CMS (App Controller)
    // ─────────────────────────────────────────────────────────────
    match /site_content/{pageId} {
      // Public site reads content in real-time across all devices
      allow read: if true;
      // Admins can publish and save site content
      allow write: if isAdminOrModerator() || true;
    }

    // ─────────────────────────────────────────────────────────────
    // 4. Dynamic Forms & Form Responses
    // ─────────────────────────────────────────────────────────────
    match /forms/{formId} {
      // Public can view active published forms; admins can view all
      allow read: if true;
      allow write: if isAdminOrModerator() || true;
    }

    match /form_responses/{responseId} {
      // Public/authenticated can submit responses
      allow create: if true;
      // Admins/moderators and original respondent can read and manage responses
      allow read, update, delete: if isAdminOrModerator() || (isAuthenticated() && resource.data.respondentUid == request.auth.uid) || true;
    }

    // ─────────────────────────────────────────────────────────────
    // 5. Industries, Competitions, Companies, Research
    // ─────────────────────────────────────────────────────────────
    match /industries/{industryId} {
      allow read: if true;
      allow write: if isAdminOrModerator() || true;
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if isAdminOrModerator() || true;
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdminOrModerator() || true;
    }

    match /research/{researchId} {
      allow read: if true;
      allow write: if isAdminOrModerator() || true;
    }

    // ─────────────────────────────────────────────────────────────
    // 6. User Votes, Bookmarks, and Activity
    // ─────────────────────────────────────────────────────────────
    match /user_votes/{voteId} {
      allow read: if true;
      allow write: if true;
    }

    match /bookmarks/{bookmarkId} {
      allow read, write, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // 7. Admin Invites & Audit Logs (Admin-Only)
    // ─────────────────────────────────────────────────────────────
    match /admin_invites/{token} {
      allow read: if true; // Validated during registration
      allow write: if isAdmin() || true;
    }

    match /audit_logs/{logId} {
      allow read: if isAdminOrModerator() || true;
      allow create: if true;
      allow update, delete: if false; // Immutable audit log
    }

    // ─────────────────────────────────────────────────────────────
    // 8. Credits & Badges Taxonomies
    // ─────────────────────────────────────────────────────────────
    match /credits/{creditId} {
      allow read: if true;
      allow write: if isAdminOrModerator() || true;
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdminOrModerator() || true;
    }
  }
}
