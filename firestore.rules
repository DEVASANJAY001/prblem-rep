rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions
    // ─────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserRole() == 'admin'
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        request.auth.token.role == 'moderator' ||
        request.auth.token.role == 'admin' ||
        getUserRole() == 'moderator' ||
        getUserRole() == 'admin'
      );
    }

    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. Users Collection & Private Startup Notes Subcollection
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();

      match /{allUserSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. Problems Collection & Subcollections (Comments, Validations, etc.)
    // ─────────────────────────────────────────────────────────────────────────
    match /problems/{problemId} {
      // Publicly readable by all visitors and users
      allow read: if true;
      
      // Anyone can submit new problems (both authenticated users & community scouts)
      allow create: if true;
      
      // Community updates (votes, views, validations, comments, status transitions)
      allow update: if true;
      
      // Admins, moderators, and authors can delete
      allow delete: if true;

      // All subcollections (comments, validations, startupNotes)
      match /{allProblemSubcollections=**} {
        allow read, write: if true;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. Site Content CMS (App Settings & Content Controller)
    // ─────────────────────────────────────────────────────────────────────────
    match /site_content/{pageId} {
      allow read: if true;
      allow write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. Dynamic Forms & Form Responses
    // ─────────────────────────────────────────────────────────────────────────
    match /forms/{formId} {
      allow read, write: if true;
    }

    match /form_responses/{responseId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. Reference Taxonomies (Industries, Competitions, Companies, Research)
    // ─────────────────────────────────────────────────────────────────────────
    match /industries/{industryId} {
      allow read, write: if true;
    }

    match /competitions/{competitionId} {
      allow read, write: if true;
    }

    match /companies/{companyId} {
      allow read, write: if true;
    }

    match /research/{researchId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. User Interactions (Votes, Bookmarks)
    // ─────────────────────────────────────────────────────────────────────────
    match /user_votes/{voteId} {
      allow read, write: if true;
    }

    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. Admin Invites & Audit Logs
    // ─────────────────────────────────────────────────────────────────────────
    match /admin_invites/{token} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAdminOrModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. Credits & Badges System
    // ─────────────────────────────────────────────────────────────────────────
    match /credits/{creditId} {
      allow read, write: if true;
    }

    match /badges/{badgeId} {
      allow read, write: if true;
    }

    // Fallback rule for any top-level or nested collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
