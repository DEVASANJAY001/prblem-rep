rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions (Zero PII / No Hardcoded Emails)
    // ─────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role-based authorization verified dynamically via user doc or auth claim
    // Zero sensitive email addresses, domains, or names exposed in rules
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        (userDocExists() && getUserData().role == 'admin')
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'moderator' ||
        (userDocExists() && (getUserData().role == 'moderator' || getUserData().role == 'admin'))
      );
    }

    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. Users Collection
    //    - Public read for community leaderboards, creator cards, and profiles
    //    - Users manage their own profiles; role escalation is blocked
    //    - Only confirmed admins can modify the 'role' field or delete accounts
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && (
        !('role' in request.resource.data.diff(resource.data).affectedKeys()) ||
        isAdmin()
      )) || isAdmin();
      allow delete: if isAdmin();

      // Private subcollections (e.g. startupNotes) restricted to owner & admins
      match /{allUserSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. Problems Collection
    //    - Public read (discovery search engine)
    //    - Authenticated users can submit problems
    //    - Community can interact (votes, views, comments)
    //    - Moderation fields (status, reviewedBy, publishedAt) restricted to admins/mods
    // ─────────────────────────────────────────────────────────────────────────
    match /problems/{problemId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdminOrModerator() ||
        (
          !('status' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('reviewedBy' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('reviewedByUid' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('publishedAt' in request.resource.data.diff(resource.data).affectedKeys()) &&
          !('verified' in request.resource.data.diff(resource.data).affectedKeys())
        )
      );
      allow delete: if isAdminOrModerator() ||
        (isAuthenticated() && resource.data.submittedByUid == request.auth.uid);

      match /{allProblemSubcollections=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. Site Content CMS (App Controller)
    //    - Public read, admin-only write
    // ─────────────────────────────────────────────────────────────────────────
    match /site_content/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. Dynamic Forms & Responses
    // ─────────────────────────────────────────────────────────────────────────
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /form_responses/{responseId} {
      allow create: if true;
      allow read, update, delete: if isAdminOrModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. Reference Taxonomies (Industries, Competitions, Companies, Research)
    //    - Public read, admin-only write
    // ─────────────────────────────────────────────────────────────────────────
    match /industries/{industryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /research/{researchId} {
      allow read: if true;
      allow write: if isAdminOrModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. User Interactions (Votes, Bookmarks)
    // ─────────────────────────────────────────────────────────────────────────
    match /user_votes/{voteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. Admin Invites & Audit Logs
    // ─────────────────────────────────────────────────────────────────────────
    match /admin_invites/{token} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdminOrModerator();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. Credits & Badges System
    // ─────────────────────────────────────────────────────────────────────────
    match /credits/{creditId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Fallback: Deny unhandled writes
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
