rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helper Functions (Zero PII / No Hardcoded Emails)
    // ─────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role-based authorization verified dynamically via user doc or auth claim
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        (userDocExists() && getUserData().role == 'admin')
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'moderator' ||
        (userDocExists() && (getUserData().role == 'moderator' || getUserData().role == 'admin'))
      );
    }

    function isAdminOrModerator() {
      return isAdmin() || isModerator();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 1. Users Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || isOwner(userId);

      match /{allUserSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin() || isAuthenticated();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 2. Problems Collection
    // ─────────────────────────────────────────────────────────────────────────
    match /problems/{problemId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();

      match /{allProblemSubcollections=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 3. Site Content CMS & App Controller (Admin / App Control)
    // ─────────────────────────────────────────────────────────────────────────
    match /site_content/{pageId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /appControl/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /app_control/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 4. Dynamic Forms & Responses
    // ─────────────────────────────────────────────────────────────────────────
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /form_responses/{responseId} {
      allow create, read, update, delete: if true;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 5. Reference Taxonomies (Industries, Competitions, Companies, Research)
    // ─────────────────────────────────────────────────────────────────────────
    match /industries/{industryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /research/{researchId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 6. User Interactions (Votes, Bookmarks)
    // ─────────────────────────────────────────────────────────────────────────
    match /user_votes/{voteId} {
      allow read, write: if isAuthenticated();
    }

    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 7. Admin Invites & Audit Logs
    // ─────────────────────────────────────────────────────────────────────────
    match /admin_invites/{token} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /audit_logs/{logId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // 8. Credits & Badges System
    // ─────────────────────────────────────────────────────────────────────────
    match /credits/{creditId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Fallback: Default allow read for unknown public collections, write if auth
    // ─────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
